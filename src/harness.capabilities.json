{
  "$schema": "antigravity-harness-capabilities-v2",
  "version": "4.0.0",
  "scope": "global",
  "metadata": {
    "runtime": "Google Antigravity / Gemini CLI",
    "platform": "Windows-first",
    "shell": "PowerShell",
    "runtime_directory": "$env:USERPROFILE\\.gemini",
    "private_marker": ".gemini-private",
    "private_state_root": "$env:USERPROFILE\\.gemini\\harness-state",
    "trash_directory": ".gemini-trash",
    "truth_rule": "No declared capability is treated as implemented, available, or verified without matching evidence."
  },
  "allowed_states": {
    "implementation_status": [
      "declared",
      "implemented",
      "verified"
