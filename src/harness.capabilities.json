    "availability": [
      "unverified",
      "available",
      "unavailable"
    ],
    "enforcement_mode": [
      "native-enforced",
      "script-enforced",
      "human-enforced",
      "policy-only",
      "unverified"
    ]
  },
  "completion_truth": {
    "states": [
      "planned",
      "attempted",
      "executed",
      "partial",
      "passed",
      "checking",
      "unverified",
      "blocked",
      "verified",
      "approved"
    ],
    "maker_may_issue": [
      "planned",
      "attempted",
      "executed",
      "partial",
      "passed",
      "checking",
      "unverified",
      "blocked"
    ],
