{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "4.0"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim_id",
          "kind",
          "text",
          "evidence_paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "reasoning",
              "statistic",
              "empirical",
              "external_fact"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
