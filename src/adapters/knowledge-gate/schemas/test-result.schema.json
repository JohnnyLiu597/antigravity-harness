{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "mechanical_checks",
    "semantic_verification",
    "trusted_external_authority",
    "generated_at",
    "input_hashes",
    "source_observations",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "4.0"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "checking",
        "blocked",
        "failed"
      ]
    },
    "mechanical_checks": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "semantic_verification": {
      "type": "string",
      "enum": [
        "unverified",
        "blocked"
      ]
    },
    "trusted_external_authority": {
      "type": "string",
      "enum": [
        "unavailable"
      ]
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "input_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact",
          "sha256"
        ],
        "properties": {
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "source_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "expected_sha256",
          "independently_observed_sha256"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "independently_observed_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "reference",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "blocked"
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
